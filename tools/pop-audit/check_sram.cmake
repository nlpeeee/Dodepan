execute_process(COMMAND "${NM}" -C "${ELF}" OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect SRAM renderer placement")
endif()
foreach(name synth_audio_main)
    string(REGEX MATCH "[0-9a-fA-F]+ [Tt] ${name}\\(\\)" match "${symbols}")
    if(NOT match MATCHES "^200[0-9a-fA-F]+ ")
        message(FATAL_ERROR "${name} is absent or outside SRAM: ${match}")
    endif()
endforeach()
string(REGEX MATCH "[0-9a-fA-F]+ [Tt] pop_capture_audio\\(" capture "${symbols}")
if(capture AND NOT capture MATCHES "^200[0-9a-fA-F]+ ")
    message(FATAL_ERROR "Audio capture hook outside SRAM: ${capture}")
endif()
message(STATUS "Audio renderer SRAM placement verified")
